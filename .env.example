# Contact form (src/app/api/contact/route.ts) sends through Google Workspace SMTP.
# SMTP_USER is one of our @landexsystems.com accounts. SMTP_PASS is a Google App
# Password for that account (Google Account > Security > 2-Step Verification > App passwords).
SMTP_USER=
SMTP_PASS=
# Optional overrides. CONTACT_TO defaults to allen@, beckett@ and auddi@landexsystems.com.
# CONTACT_TO=allen@landexsystems.com,beckett@landexsystems.com,auddi@landexsystems.com
# CONTACT_FROM="Landex Systems <contact@landexsystems.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
